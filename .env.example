# WealthChronicle AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Google Gemini API Key (from Google I Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# Qdrant Cloud Cluster URL (e.g., https://xxx.eu-central-1-0.aws.cloud.qdrant.io:6333)
QDRANT_URL="https://your-cluster-id.region.aws.cloud.qdrant.io:6333"

# Qdrant API Keys
# QDRANW_READ_KEY: Used by public query interface (read-only access)
QDRANT_READ_KEY="your-qdrant-read-only-api-key-here"

# QDRANW_ADMIN_KEY: Used exclusively by admin ingestion script (ingest.py)
QDRANT_ADMIN_KEY="your-qdrant-admin-api-key-here"
